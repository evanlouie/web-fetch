{
  "name": "mcp-web-fetch",
  "version": "0.1.0",
  "private": true,
  "description": "Fetch web pages as Markdown with a real browser's TLS and HTTP/2 fingerprint, from the command line or as an MCP server over stdio.",
  "bin": {
    "mcp-web-fetch": "./src/main.ts"
  },
  "type": "module",
  "scripts": {
    "format": "oxfmt --disable-nested-config .",
    "format:check": "oxfmt --disable-nested-config --check .",
    "lint": "oxlint --disable-nested-config --type-aware --type-check",
    "test": "bun test",
    "check": "bun run format:check && bun run lint && bun run test"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.2",
    "defuddle": "^0.19.5",
    "effect": "4.0.2",
    "linkedom": "^0.18.13",
    "wreq-js": "^3.2.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2004"
  },
  "overrides": {
    "@effect/platform-node-shared": "4.0.2"
  },
  "engines": {
    "bun": ">=1.4.3"
  },
  "packageManager": "bun@1.4.3"
}
